{
  "threshold": 3,
  "minLines": 10,
  "minTokens": 50,
  "pattern": "**/*.{ts,html,css,scss}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.spec.ts",
    "**/*.generated.ts",
    "projects/ui/tokens/colors.css",
    "projects/ui/tokens/design-systems/*/index.css"
  ],
  "reporters": ["console"],
  "exitCode": 1
}
