{
  "name": "argila",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build ui",
    "watch": "ng build ui --watch --configuration development",
    "test": "ng test ui --watch=false",
    "typecheck": "tsc --noEmit -p projects/ui/tsconfig.lib.json && tsc --noEmit -p projects/ui/tsconfig.spec.json && tsc --noEmit -p projects/ui/.storybook/tsconfig.json",
    "lint": "ng lint",
    "dup:check": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@angular-devkit/architect": "^0.2202.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular-eslint/builder": "22.5.0",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jscpd": "5.3.3",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,scss,json,md,mdx,yml,yaml,js}": "prettier --write"
  }
}
