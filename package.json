{
  "name": "argila",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build ui",
    "watch": "ng build ui --watch --configuration development",
    "test": "pnpm manifest && pnpm test:jest --ci",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "pnpm test:jest --watch --coverage=false",
    "test:ui": "pnpm test:jest --selectProjects ui",
    "test:docs": "pnpm manifest && pnpm test:jest --selectProjects docs",
    "test:scripts": "pnpm test:jest --selectProjects scripts",
    "test:coverage": "pnpm manifest && pnpm test:jest --coverageReporters=text --coverageReporters=html",
    "test:report": "node scripts/relatorio-de-testes.ts",
    "typecheck": "pnpm manifest && tsc --noEmit -p projects/ui/tsconfig.lib.json && tsc --noEmit -p projects/ui/tsconfig.spec.json && tsc --noEmit -p projects/docs/tsconfig.app.json && tsc --noEmit -p projects/docs/tsconfig.spec.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "ng lint && eslint scripts --max-warnings 0",
    "dup:check": "jscpd",
    "arch:check": "depcruise projects scripts --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gerar-icones.ts",
    "icons:check": "node scripts/gerar-icones.ts --check",
    "colors": "node scripts/gerar-cores.ts",
    "colors:check": "node scripts/gerar-cores.ts --check",
    "checkup": "node scripts/checkup-visual.ts",
    "comparar": "node scripts/comparar-referencia.ts",
    "dev": "pnpm manifest && ng serve docs --open",
    "manifest": "node scripts/gerar-manifesto.ts",
    "manifest:check": "node scripts/gerar-manifesto.ts --check",
    "build:docs": "pnpm manifest && ng build docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jest": "29.17.0",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-preset-angular": "17.0.3",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "node --experimental-vm-modules node_modules/jest/bin/jest.js --bail --findRelatedTests --passWithNoTests --coverage=false"
    ],
    "*.html": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,scss,json,md,yml,yaml,js}": "prettier --write"
  }
}
